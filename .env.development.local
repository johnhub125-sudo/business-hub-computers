# Used only by `next dev` on this machine. Overrides .env.local so local testing never touches the live database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5435/postgres
DB_POOL_MAX=1

# Local dev only: sign-in cookies must belong to localhost, not the live https site.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
