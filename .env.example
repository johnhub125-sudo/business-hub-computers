# ─────────────────────────────────────────────────────────────────────────────
# Business Hub Computers — environment template
# Copy to .env.local for local development. In Vercel, set these per environment
# (Development / Preview / Production) in Project → Settings → Environment Variables.
# NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "development" | "preview" | "production" (Vercel sets VERCEL_ENV automatically)
APP_ENV=development

# ── Database (Neon via Vercel Marketplace injects DATABASE_URL automatically) ──
# Local: `npm run db:local` then use the value below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Optional pool size override (local PGlite needs 1)
DB_POOL_MAX=

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First Super Admin (used once by `npm run admin:bootstrap`; forced password change on first login)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Paystack (Dashboard → Settings → API Keys & Webhooks) ────────────────────
# Test keys are used unless the Super Admin switches to LIVE in /admin/settings/payments.
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_TEST_SECRET_KEY=
# Only set live keys in the Production environment.
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
# Note: Paystack signs webhooks with your secret key (HMAC-SHA512) — no separate webhook secret exists.

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Until your domain is verified use: Business Hub Computers <onboarding@resend.dev>
EMAIL_FROM=
# Where admin alerts go (low stock, bank transfers awaiting verification, security)
ADMIN_ALERT_EMAIL=

# ── Storage: S3-compatible (Cloudflare R2 recommended — see docs/setup/cloudflare-r2.md). Used when all four are set ─
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional; leave unset for Cloudflare R2 ("auto")
S3_REGION=

# ── Storage fallback (Vercel Blob — created in Vercel → Storage; injected automatically) ─
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Optional: "private" if the Blob store was created with private access (auto-detected otherwise)
BLOB_STORE_ACCESS=

# ── Google Maps (browser key, restricted by HTTP referrer in Google Cloud) ───
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── WhatsApp Cloud API (optional — falls back to wa.me links if unset) ──────
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

# ── Rate limiting (Upstash Redis via Vercel Marketplace; falls back to Postgres) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Optional: Upstash QStash for frequent schedules on the Vercel Hobby plan
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
